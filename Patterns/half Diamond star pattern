class Main {
    public static void main(String[] args) {
        int i,j;
        int N =5;
        for (i = 0; i < N; i++)
    {
        for (j = 0; j < i + 1; j++)
            System.out.print("*");
        System.out.print("\n");
    }
    for (i = 1; i < N; i++)
    {
        for (j = i; j < N; j++)
            System.out.print("*");
        System.out.print("\n");
    }
    }
}

